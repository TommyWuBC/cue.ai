# ─────────────────────────────────────────────────────────────────────────────
#  Cue — environment
#  Copy to .env and fill in. .env is gitignored; never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── xAI / Grok ───────────────────────────────────────────────────────────────
# One key covers BOTH the reasoning layer and speech-to-text.
# Get it at: https://console.x.ai  →  API Keys  →  Create API Key
XAI_API_KEY=

# Reasoning model. grok-4.20-0309-non-reasoning answers in ~0.5s vs ~2.5s for the
# reasoning models, and gives shorter answers, which is what you want read aloud.
# Check what your key can call: curl localhost:4173/models
GROK_MODEL=grok-4.20-0309-non-reasoning

# ── Speech to text (Grok) ────────────────────────────────────────────────────
# grok | browser
#   grok    — streams mic audio through our server to wss://api.x.ai/v1/stt.
#             Far better than the browser recogniser in a loud room, and it
#             supports push-to-talk finalisation properly.
#   browser — Web Speech API. No key needed. Fallback only.
STT_PROVIDER=grok
STT_MODEL=grok-voice-transcribe-2.0
STT_LANGUAGE=en
# Silence (ms) before an utterance is considered finished.
STT_ENDPOINTING=380
# Bias the recogniser toward words it will actually hear on this page.
STT_KEYTERMS=Cue,wool,merino,puffer,trench,cardigan,denim,checkout,cart,medium,large

# ── ElevenLabs (responses only) ──────────────────────────────────────────────
# browser | eleven
TTS_PROVIDER=eleven
ELEVENLABS_API_KEY=

# Voice. Default is Rachel (warm, neutral, conversational).
# Browse + copy other ids at: https://elevenlabs.io/app/voice-library
ELEVEN_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# eleven_turbo_v2_5  — best quality/latency balance for a live demo  (recommended)
# eleven_flash_v2_5  — fastest + half the credits, slightly flatter
# eleven_multilingual_v2 — highest quality, too slow to converse with
ELEVEN_MODEL=eleven_turbo_v2_5

# Hard stop, in characters. When exhausted we fall back to the browser voice
# instead of failing. Repeats are served from disk cache and cost nothing.
ELEVEN_CHAR_BUDGET=20000

# Local demo checkout. Open exactly http://localhost:4173 for passkey origin matching.
CUE_RP_ID=localhost
CUE_ORIGIN=http://localhost:4173
CUE_MONTHLY_LIMIT_CENTS=25000
CUE_ORDER_LIMIT_CENTS=20000
